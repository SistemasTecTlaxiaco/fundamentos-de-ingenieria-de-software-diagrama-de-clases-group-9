{
  "practica": "Práctica 9 · Diagrama de clases (UML)",
  "imagenes_minimas": 1,
  "imagenes_en": [
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg"
  ],
  "archivos_recomendados": [
    {
      "patrones": [
        "**/*.qea",
        "**/*.qeax",
        "**/*.eap",
        "**/*.eapx"
      ],
      "nombre": "el proyecto de Architect (`.qea` o `.eap`) en `modelo/`"
    },
    {
      "patrones": [
        "**/trazabilidad*.csv",
        "**/*trazabilidad*"
      ],
      "nombre": "la tabla de trazabilidad (en el documento o como `docs/analisis/trazabilidad.csv`)"
    }
  ],
  "secciones": [
    {
      "criterio": "1. Clases identificadas desde el DRS",
      "min_palabras": 30,
      "comprobaciones": [
        {
          "patron": "\\b(rf|rnf|rd)[-_ ]?\\d+",
          "min": 4,
          "mensaje": "Liguen cada clase con su requisito: se esperan al menos 4 citas como RF-01, RNF-02 o RD-01."
        }
      ],
      "prohibido": [
        {
          "patron": "^\\s*\\|?\\s*sistema\\s*\\|",
          "mensaje": "Aparece una clase «Sistema»; la rúbrica no la acepta como clase del dominio."
        }
      ],
      "titulos": [
        "Clases identificadas",
        "Clases identificadas desde el DRS",
        "Identificación de clases",
        "Identificacion de clases",
        "Clases del DRS",
        "Carrera de sustantivos",
        "Clases"
      ]
    },
    {
      "criterio": "2. Atributos y tipos de datos",
      "min_palabras": 15,
      "comprobaciones": [
        {
          "patron": "(\\b[a-z]\\w*\\s*:\\s*[a-z]\\w*|^[-+#~]?\\s*[a-z]\\w*\\s*$\\n^\\s*(string|int|integer|decimal|date|boolean|float|double|texto|entero|fecha)\\b)",
          "min": 4,
          "mensaje": "Escriban los atributos con su tipo, como «kilos: decimal» (al menos 4)."
        }
      ],
      "titulos": [
        "Atributos y tipos",
        "Atributos y tipos de datos",
        "Especificación de clases",
        "Atributos",
        "Especificacion de las clases",
        "Diccionario de clases"
      ]
    },
    {
      "criterio": "3. Operaciones ligadas a los requisitos",
      "min_palabras": 15,
      "comprobaciones": [
        {
          "patron": "\\b[a-z]\\w*\\s*\\([^)\\n]*\\)",
          "min": 3,
          "mensaje": "Escriban las operaciones con paréntesis y parámetros, como «registrar(kilos: decimal)» (al menos 3)."
        },
        {
          "patron": "\\brf[-_ ]?\\d+",
          "min": 2,
          "mensaje": "Indiquen de qué RF sale cada operación (al menos 2 citas)."
        }
      ],
      "titulos": [
        "Operaciones",
        "Operaciones ligadas a los requisitos",
        "Especificación de clases",
        "Operaciones y métodos",
        "Métodos",
        "Responsabilidades"
      ]
    },
    {
      "criterio": "4. Encapsulamiento y visibilidad",
      "min_palabras": 20,
      "comprobaciones": [
        {
          "patron": "(privad|public|protegid|^\\s*[-+#~]\\s*[a-z])",
          "min": 1,
          "mensaje": "Expliquen qué es privado (−) y qué es público (+), y por qué."
        }
      ],
      "titulos": [
        "Encapsulamiento y visibilidad",
        "Visibilidad",
        "Encapsulamiento"
      ]
    },
    {
      "criterio": "5. Asociaciones y multiplicidad",
      "min_palabras": 20,
      "comprobaciones": [
        {
          "patron": "(\\d|\\*)\\s*\\.\\.\\s*(\\d+|\\*|n)\\b|(\\d|\\*)\\s*\\.\\.\\s*\\*",
          "min": 2,
          "mensaje": "Escriban la multiplicidad de las asociaciones, como 1..* o 0..1 (al menos 2)."
        }
      ],
      "titulos": [
        "Asociaciones y multiplicidad",
        "Asociaciones",
        "Relaciones",
        "Multiplicidad",
        "Relaciones entre clases"
      ]
    },
    {
      "criterio": "6. Agregación, composición y herencia",
      "min_palabras": 20,
      "comprobaciones": [
        {
          "patron": "(agregacion|composicion|herencia|generalizacion)",
          "min": 1,
          "mensaje": "Expliquen cuál usaron y por qué, o por qué su modelo no las necesita."
        }
      ],
      "titulos": [
        "Agregación, composición y herencia",
        "Agregación y composición",
        "Composición",
        "Herencia",
        "Relaciones especiales"
      ]
    },
    {
      "criterio": "7. Trazabilidad con el DRS y el BPMN",
      "min_palabras": 15,
      "comprobaciones": [
        {
          "patron": "\\b(rf|rnf|rd)[-_ ]?\\d+",
          "min": 4,
          "mensaje": "La tabla de trazabilidad debe citar al menos 4 requisitos."
        }
      ],
      "titulos": [
        "Trazabilidad",
        "Trazabilidad con el DRS y el BPMN",
        "Matriz de trazabilidad"
      ]
    },
    {
      "criterio": "8. Notación UML y uso de Architect",
      "min_palabras": 0,
      "comprobaciones": [
        {
          "patron": "(architect|\\.qea|enterprise)",
          "min": 1,
          "aviso": true,
          "mensaje": "Indiquen que el diagrama se hizo en Architect y suban el .qea a modelo/."
        }
      ],
      "titulos": [
        "Diagrama y notación UML",
        "Notación UML y uso de Architect",
        "Notación UML",
        "Diagrama de clases",
        "Uso de Architect",
        "Diagrama"
      ]
    },
    {
      "criterio": "9. Trabajo por pull request",
      "min_palabras": 0,
      "comprobaciones": [
        {
          "patron": "(#\\d+|pull request)",
          "min": 1,
          "mensaje": "Indiquen qué pull requests abrió y revisó cada integrante (por ejemplo, #3)."
        }
      ],
      "titulos": [
        "Trabajo en equipo",
        "Trabajo por pull request",
        "Pull requests",
        "Trabajo colaborativo",
        "Bitácora del equipo"
      ],
      "github": "pull_requests",
      "buscar_en_todo": false,
      "al_final": true
    },
    {
      "criterio": "10. Revisión cruzada y mejora",
      "min_palabras": 30,
      "comprobaciones": [
        {
          "patron": "(observ|reviso|revisor|coment|senal)",
          "min": 1,
          "mensaje": "Anoten las observaciones que hizo el equipo revisor."
        },
        {
          "patron": "(corregi|justific|cambi|atend)",
          "min": 1,
          "mensaje": "Anoten qué corrigieron o justificaron por cada observación."
        }
      ],
      "titulos": [
        "Revisión cruzada",
        "Revisión cruzada y mejora",
        "Revisión entre equipos",
        "Retroalimentación",
        "Observaciones del equipo revisor",
        "Mejoras"
      ],
      "github": "revision",
      "buscar_en_todo": false
    }
  ],
  "buscar": [
    "entrega/**/*.pdf",
    "entrega/**/*.docx",
    "entrega/**/*.md",
    "*.pdf",
    "*.docx",
    "docs/**/*.pdf",
    "docs/**/*.docx"
  ],
  "ignorar": [
    "guia-de-entrega.md",
    "leeme.md",
    "plantilla-practica-9.docx",
    "readme.md",
    "rubrica.md"
  ],
  "palabras_minimas_entrega": 150
}